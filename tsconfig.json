{
  "compilerOptions": {
    "target": "esnext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "rootDir": "./",
    "lib": ["ESNext"],
    "types": ["node"]
  },
  "include": ["./src"],
  "exclude": ["node_modules", "dist", "src/plugin"]
}
