{
  "name": "phoenix-figma-mcp",
  "description": "Phoenix Figma MCP: read and edit the open Figma file from an MCP client through a local plugin bridge. No Figma API token required.",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "socket": "pnpm run build:plugin && node ./src/socket.ts",
    "build:plugin": "tsc -p src/plugin/tsconfig.json",
    "start": "node ./src/server.ts",
    "dev": "node --watch ./src/server.ts",
    "typecheck:node": "tsc -p tsconfig.json --noEmit",
    "typecheck:plugin": "tsc -p src/plugin/tsconfig.json --noEmit",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:plugin",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "verify": "pnpm run build:plugin && pnpm run typecheck && node ./src/scripts/relay-smoke.ts && node ./src/scripts/mcp-smoke.ts && node --test src/scripts/*.test.ts",
    "dev:plugin": "tsc -p src/plugin/tsconfig.json --watch",
    "test": "pnpm run build:plugin && node --test src/scripts/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "uuid": "^14.0.2",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.140.0",
    "@types/node": "^26.6.4",
    "@types/ws": "^8.18.2",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2"
  },
  "repository": {
    "url": "git+https://github.com/mirasayon/phoenix-figma-mcp.git",
    "type": "git"
  },
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24"
  }
}
