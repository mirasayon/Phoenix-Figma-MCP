{
  "name": "figma-mcp-mh",
  "description": "Figma MCP server for Cursor: read and write the open Figma file via a local WebSocket plugin bridge (no REST API, no token, no rate limits).",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "socket": "node ./src/socket.ts",
    "presocket": "npm run build:plugin",
    "build:plugin": "tsc -p src/plugin/tsconfig.json",
    "start": "node ./src/server.ts",
    "dev": "node --watch ./src/server.ts",
    "typecheck:node": "tsc -p tsconfig.json --noEmit",
    "typecheck:plugin": "tsc -p src/plugin/tsconfig.json --noEmit",
    "typecheck": "npm run typecheck:node && npm run typecheck:plugin",
    "format": "prettier . --write",
    "mix": "repomix",
    "format:check": "prettier . --check",
    "verify": "npm run build:plugin && npm run typecheck && node ./src/scripts/relay-smoke.ts && node ./src/scripts/mcp-smoke.ts && node --test src/scripts/*.test.ts",
    "update": "npx npm-check-updates -u && npm install && npm run format",
    "update:check": "npx npm-check-updates",
    "dev:plugin": "tsc -p src/plugin/tsconfig.json --watch",
    "test": "npm run build:plugin && node --test src/scripts/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "uuid": "^14.0.2",
    "ws": "^8.21.3",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.138.0",
    "@types/node": "^26.4.1",
    "@types/uuid": "^11.0.0",
    "@types/ws": "^8.18.1",
    "npm-check-updates": "^23.1.0",
    "prettier": "^3.9.6",
    "repomix": "^1.18.0",
    "typescript": "^7.0.2"
  },
  "repository": {
    "url": "git+https://github.com/mirx86/phoenix-figma-mcp.git",
    "type": "git"
  },
  "engines": {
    "node": ">=24"
  }
}
